# Template only. Never put real secrets in this repository or the public docroot.
STRIPE_MODE=test
# Enable only after the hosted Stripe trial, cancellation and webhook checks.
PLAYMELT_BILLING_VERIFIED=0
PLAYMELT_RELEASE=2.2.0
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Dedicated named Playmelt configuration, always selected by its explicit ID.
# Required before enabling billing; absent while billing is off leaves accounts usable.
# Test: compte-test/ ; Live: compte/ . Exact Playmelt CGV/privacy URLs, scope metadata
# playmelt_scope=billing-portal, cancellation at period end without prorations,
# payment method/history enabled, subscription/customer updates and public login disabled.
STRIPE_PORTAL_CONFIGURATION=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_QUARTERLY=
STRIPE_PRICE_SEMIANNUAL=
STRIPE_PRICE_ANNUAL=
STRIPE_PRICE_LIFETIME=
STRIPE_AUTOMATIC_TAX=false
PLAYMELT_PUBLIC_URL=https://7agency.fr/Playmelt/compte
PLAYMELT_DATABASE=/home/vena7840/playmelt-commerce/shared/account.sqlite
PLAYMELT_PRIVATE_ROOT=/home/vena7840/playmelt-commerce/shared
PLAYMELT_DOCUMENT_ROOT=/home/vena7840/7agency.fr
PLAYMELT_SIGNING_KEY_FILE=/home/vena7840/playmelt-commerce/shared/licence-signing.pem
PLAYMELT_TERMS_VERSION=2026-11-12
PLAYMELT_TERMS_SHA256=
PLAYMELT_TERMS_FILE=/home/vena7840/7agency.fr/Playmelt/legal/conditions-de-vente/index.html
PLAYMELT_TERMS_URL=https://7agency.fr/Playmelt/legal/conditions-de-vente/
PLAYMELT_PRIVACY_URL=https://7agency.fr/Playmelt/legal/confidentialite/
PLAYMELT_SUPPORT_EMAIL=contact@7agency.fr
PLAYMELT_SUPPORT_ADMINS=
PLAYMELT_ADMINS=
PLAYMELT_OWNER_EMAIL=
# Internal accounts are retained but excluded from customer KPIs. Defaults to OWNER_EMAIL.
PLAYMELT_INTERNAL_EMAILS=
# Optional downloaded Google OAuth web-client JSON. Must be private (0600), outside web/Git.
# Include only the exact HTTPS callback of this account service; no Gmail/Drive scopes.
PLAYMELT_GOOGLE_OAUTH_FILE=
# Optional single-account test service, permitted only with STRIPE_MODE=test.
# Use a separate database/public URL/private root and matching Google callback.
# Its outgoing e-mails are restricted to this mailbox; it cannot promote production's download pin.
PLAYMELT_TEST_ACCOUNT_EMAIL=
# Leave FILE empty until the approved commercial 2.2.0 DMG is placed outside the public
# document root. Private file must be owned by the service, mode 0600, no links.
# Record SHA256 and exact byte size from the approved source, never guess them.
# Use the native owner's approved package receipt for SHA256/bytes. A development
# signature is not Apple trust, and these fields do not prove the native licence gate.
# No public URL fallback. Updating an artifact requires a verified service restart.
# With billing enabled, FILE is required outside unit tests, except for the explicit
# single-account Stripe test sandbox (TEST_ACCOUNT_EMAIL set and live mode off).
# The verified tuple is pinned durably in this database. A different hash at the
# same version or a downgrade after 2.2.0 is refused, even with billing disabled.
# 2.1.0 is legacy-only before promotion and while billing is disabled; no automatic rollback.
# Isolated TEST_ACCOUNT_EMAIL services have a separate download pin, not production's.
# This browser download is not an authenticated updater; keep automatic updates
# disabled until the native update transport and signed package are qualified.
PLAYMELT_DOWNLOAD_FILE=
PLAYMELT_DOWNLOAD_VERSION=2.2.0
PLAYMELT_DOWNLOAD_FILENAME=Playmelt-2.2.0.dmg
PLAYMELT_DOWNLOAD_SHA256=
PLAYMELT_DOWNLOAD_BYTES=
MAIL_FROM=Playmelt <contact@7agency.fr>
# o2switch: fixed loopback MTA, no password. External SMTP always requires TLS.
MAIL_TRANSPORT=local-smtp
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
